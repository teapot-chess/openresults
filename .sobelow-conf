# Sobelow (Phoenix security scanner) - `mix sobelow --config`, run by precommit and CI.
#
# skip: true  - findings recorded in .sobelow-skips are accepted. Every entry there
# was read in context and is a false positive:
#   * Traversal.FileModule - paths are server-built (data dir, backup staging and
#     temp files, FIDE list downloads, the moderation journal); none is a raw
#     user string.
#   * XSS.SendResp / XSS.Raw - bodies are escaped HTML builders, feed/sitemap XML,
#     or the repo's own changelog; `raw(gettext(...))` is a translator-owned string.
#   * DOS.StringToAtom - every atom comes from a literal list or a regex-bounded
#     SAN letter, never from request data.
#   * SQL.Query - table names are module attributes, never request data.
#   * Config.CSP - Phoenix's default header is on the browser pipeline and
#     OpenResultsWeb.Framing deliberately loosens frame-ancestors; there is no
#     script-src policy (reported, not skipped silently: see the commit message).
#   * Config.CSWH - check_origin is set in config/runtime.exs.
#   * CI.System - fixed `df` lookup via System.find_executable/1.
[
  exit: :low,
  format: "txt",
  ignore: [],
  ignore_files: [],
  include_mix_tasks: false,
  include_scripts: false,
  out: nil,
  private: false,
  router: nil,
  skip: true,
  summary: false,
  threshold: :low,
  verbose: false
]
