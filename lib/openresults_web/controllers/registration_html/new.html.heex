<.masthead payload={@payload} slug={@slug} current={:register} />
<section>
  <h2>
    {gettext("Enter this tournament")}
    <span :if={Tournament.info(@payload)["start_date"]} class="quiet">
      {gettext("starts %{date}", date: date(Tournament.info(@payload)["start_date"]))}
    </span>
  </h2>
  
  <p class="footnote">
    {gettext(
      "This form sends your details to the arbiter of %{tournament}. It does not enter you. The tournament is run on the arbiter's own machine; this page only holds what you send until they collect it, and they decide who plays. Nothing here will change until they enter you and publish a round.",
      tournament: Tournament.name(@payload)
    )}
  </p>
   <.entry_facts payload={@payload} places={@places} />
  <.entry_form
    form={@form}
    slug={@slug}
    rounds={@rounds}
    alarm={@alarm}
    trap={@trap}
    trap_name={@trap_name}
    fide_search?={@fide_search?}
    fide_available?={@fide_available?}
    fide_url={~p"/t/#{@slug}/fide"}
  />
</section>
 <.entry_list :if={Tournament.entry_list_public?(@payload)} payload={@payload} places={@places} />
