<header class="masthead">
  <h1>{gettext("Too many reports")}</h1>
</header>

<section>
  <p class="empty">
    <%= if @lookup? do %>
      {gettext("Several lookups have already come from this connection, so this one was not run.")}
    <% else %>
      {gettext(
        "Several reports have already arrived from this connection, so this one was not sent."
      )}
    <% end %>
    {ngettext(
      "Try again in about %{count} minute.",
      "Try again in about %{count} minutes.",
      @minutes
    )}
  </p>

  <p><a href={@back}>{gettext("Back")}</a></p>
</section>
