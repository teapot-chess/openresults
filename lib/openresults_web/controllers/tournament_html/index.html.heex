<header class="masthead">
  <h1>OpenResults</h1>

  <p class="details">
    <span>
      {ngettext(
        "Live, upcoming, and finished in the last %{count} day.",
        "Live, upcoming, and finished in the last %{count} days.",
        @recent_days
      )}
    </span>
  </p>
</header>
<OpenResultsWeb.HubHTML.hub_nav current={:front} />
<OpenResultsWeb.HubHTML.search_form id="front-search" />
<section>
  <p :if={@snapshots == []} class="empty" id="front-empty">
    {gettext("Nothing is being played right now, and nothing finished recently.")}
    <a href={~p"/federations"}>{gettext("Everything published here, by federation")}</a>
  </p>

  <%!-- Hidden until `html.has-js` says the script that drives it actually
        ran - see `OpenResultsWeb.TournamentHTML.standings_table/1`'s own
        moduledoc for why a control that filters nothing without JavaScript
        is worse than no control at all. Every tournament below still
        renders, grouped, with the script switched off. --%>
  <div :if={@snapshots != []} class="index-controls" data-index-controls>
    <label class="index-search">
      <span class="visually-hidden">{gettext("Filter this page")}</span>
      <input
        type="search"
        class="index-search-input"
        placeholder={gettext("Filter this page…")}
        autocomplete="off"
        data-index-search
      />
    </label>

    <p class="empty" data-index-empty hidden>
      {gettext("No tournaments match your search.")}
    </p>
  </div>

  <div :if={@snapshots != []} data-index-panel>
    <section :for={{kind, entries} <- @groups} :if={entries != []} data-group={kind}>
      <h2>{group_title(kind)}</h2>

      <ul class="tournaments">
        <%!-- An event: its name, and its tournaments under it by label. One
              row as far as the search is concerned - `data-name` holds the
              event's name and every section's, so typing either finds it. --%>
        <li
          :for={{:event, event, members} <- entries}
          class="event-entry"
          data-event={event.id}
          data-name={
            Enum.join(
              [event.name | Enum.map(members, fn {_l, s} -> Tournament.name(s.payload) end)],
              " "
            )
          }
        >
          <a href={~p"/e/#{event.id}"}>{event.name}</a>
          <span class="details event-sections">
            <a
              :for={{label, snapshot} <- members}
              href={~p"/t/#{snapshot.tournament_slug}"}
              title={Tournament.name(snapshot.payload)}
            >
              {label}
            </a>
          </span>
        </li>

        <li
          :for={{:tournament, snapshot} <- entries}
          data-name={Tournament.name(snapshot.payload)}
          data-city={
            Tournament.show?(snapshot.payload, "city") &&
              data_value(Tournament.info(snapshot.payload)["city"])
          }
          data-federation={
            Tournament.show?(snapshot.payload, "federation") &&
              data_value(Tournament.info(snapshot.payload)["federation"])
          }
        >
          <a href={~p"/t/#{snapshot.tournament_slug}"}>
            {Tournament.name(snapshot.payload)}
          </a>

          <OpenResultsWeb.HubHTML.unapproved :if={
            MapSet.member?(@pending, snapshot.tournament_slug)
          } />
          <%!-- The same two ticks the masthead honours on every other page. This list
                did not consult them, so an arbiter who turned the city or the dates
                off saw them gone from their tournament's own pages and still
                printed here, on the one page nobody navigates away from. A display
                rule that holds on four pages out of five is not a rule. --%>
          <span class="details">
            <span :if={
              Tournament.show?(snapshot.payload, "city") &&
                Tournament.info(snapshot.payload)["city"]
            }>
              {Tournament.info(snapshot.payload)["city"]}
            </span>

            <span :if={
              Tournament.show?(snapshot.payload, "dates") &&
                dates(Tournament.info(snapshot.payload))
            }>
              {dates(Tournament.info(snapshot.payload))}
            </span>
          </span>
        </li>
      </ul>
    </section>
  </div>
</section>
{OpenResultsWeb.InlineScripts.tag("index_search")}
<p class="hub-more" id="front-more">
  <a href={~p"/federations"}>{gettext("Older tournaments: browse by federation")}</a>
</p>
