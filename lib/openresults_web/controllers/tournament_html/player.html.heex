<.masthead payload={@payload} slug={@slug} current={@current} />

<%!-- Two sections, and the split is load-bearing. The overlay card fetches
      this page and lifts `#player-summary` out of it, so that is everything
      a peek should show: who, where they placed, and what the tie-breaks
      were made of. Everything below it is the reason to open the page
      properly - the chart, the round-by-round table, and every contribution
      named against the round it came from.

      Before the working existed the overlay took the page's only section,
      so a right-click and a left-click produced the same thing and the
      overlay's whole value was not losing your place in the standings. --%>
<section id="player-summary">
  <h2>
    <span :if={Tournament.show?(@payload, "title") && @player["title"]} class="title">
      {@player["title"]}
    </span>
    {@player["name"]}
    <span class="quiet">{gettext("no. %{number}", number: @player["no"])}</span>
  </h2>

  <p class="details">
    <span :if={Tournament.show?(@payload, "rating") && @player["rating"]}>{@player["rating"]}</span>
    <span :if={Tournament.show?(@payload, "federation") && @player["federation"]}>
      {@player["federation"]}
    </span>
    <span :if={Tournament.show?(@payload, "club") && @player["club"]}>{@player["club"]}</span>
    <span :if={Tournament.show?(@payload, "category") && @player["category"]}>
      {gettext("Category %{category}", category: @player["category"])}
    </span>
  </p>

  <.placing payload={@payload} slug={@slug} no={@player["no"]} />

  <%!-- Only in the overlay, where there is somewhere further to go. On the
        page itself the detail is already underneath. --%>
  <p class="card-more">
    <a href={~p"/t/#{@slug}/player/#{@player["no"]}"}>{gettext("Full card, round by round")}</a>
  </p>
</section>

<section id="player-detail">
  <%!-- Up top, next to the name, because this is the one link on the page
        that leaves the tournament for the player. A button, not a footnote.
        Its own class: `.card-more` is hidden on the page itself. --%>
  <p :if={@player["fide_id"]} class="history-link">
    <a id="player-history-link" class="history-button" href={~p"/players/#{@player["fide_id"]}"}>
      {gettext("All tournaments of %{name}", name: @player["name"])}
    </a>
  </p>

  <%!-- Outside the summary, so the right-click peek does not carry a switch
        for the page it is peeking at. Only where the pages it pins rows on
        exist. --%>
  <.follow_button
    :if={
      Tournament.show?(@payload, "player_cards") and
        (Tournament.show?(@payload, "standings") or Tournament.show?(@payload, "pairings"))
    }
    slug={@slug}
    no={@player["no"]}
  />
  <%!-- Deliberately outside #player-summary: the overlay lifts that section
        verbatim for the right-click peek, and this is not part of the peek -
        it is a reason to leave this tournament altogether, which belongs
        with the rest of "open the page properly". Never by name - see
        `OpenResultsWeb.PlayerHistory` for why matching on a name would
        silently merge two different people. A player with no FIDE id gets no
        cross-link at all, here or anywhere else. --%>
  <%!-- A link that follows the player from round to round - see
        `TournamentController.board/2`. Worth bookmarking, so it says what it
        will keep doing rather than which round it points at today. --%>
  <p
    :if={Tournament.show?(@payload, "pairings") and Tournament.rounds(@payload) != []}
    class="card-more"
  >
    <a href={~p"/t/#{@slug}/player/#{@player["no"]}/board"}>
      {gettext("Their board in the latest round")}
    </a>
  </p>

  <%!-- Standings-derived, like the cross-table: nothing here until the
        arbiter folds a round into the published standings, however many
        rounds are already live - see `Tournament.within_standings?/2` and
        `Tournament.card/2`. --%>
  <p :if={@card == []} class="empty">
    {gettext("Results appear here once the standings after round 1 are published.")}
  </p>

  <.score_chart :if={@card != []} payload={@payload} card={@card} no={@player["no"]} />

  <h3 :if={@card != []}>{gettext("Round by round")}</h3>

  <.card_table :if={@card != []} slug={@slug} card={@card} payload={@payload} />

  <.withheld_results_note rounds={Tournament.withheld_result_rounds(@payload)} payload={@payload} />

  <p :if={@card != [] and Enum.any?(@card, &is_nil(&1.score))} class="footnote">
    {raw(
      gettext(
        "The running score stops at the first round whose result is not public - an unpublished round, a board that is not listed, or a game with no result yet. The arbiter's own total is on the %{standings}.",
        standings: anchor(~p"/t/#{@slug}", gettext("standings"))
      )
    )}
  </p>

  <.working_tables payload={@payload} slug={@slug} no={@player["no"]} />
</section>
