<%= if @display? do %>
  <.projector_round payload={@payload} slug={@slug} round={@round} players={@players} />
<% else %>
  <.masthead
    payload={@payload}
    slug={@slug}
    current={@current}
    query={OpenResultsWeb.FilterParams.to_params(@filters)}
  />

  <section>
    <%!-- The "dates" tick covers a round's own date as well as the
          tournament's - that is what it says on the arbiter's settings page,
          and it is the only reading that makes sense: a tournament whose dates
          are hidden but whose five round pages each print one is not hiding
          anything. The masthead above already honours it; this heading did
          not. --%>
    <div class="round-heading">
      <h2>
        {Tournament.round_heading(@payload, @round["number"])}
        <span :if={Tournament.show?(@payload, "dates") && @round["date"]} class="quiet">
          {date(@round["date"])}
        </span>
        <.live_marker round={@round} />
      </h2>
      <%!-- The engine's pairing proof, when the round has one: a small
            pill beside the heading, closed until asked. --%>
      <.round_proof round={@round} slug={@slug} />
    </div>

    <.withheld_results_note
      rounds={if Tournament.results_public?(@round), do: [], else: [@round["number"]]}
      payload={@payload}
    />

    <.matches_table
      :if={Tournament.team_event?(@payload)}
      payload={@payload}
      slug={@slug}
      round={@round}
      players={@players}
    />

    <.pairings_table
      slug={@slug}
      round={@round}
      players={@players}
      payload={@payload}
      filters={@filters}
    />
  </section>

  <section :if={Tournament.show?(@payload, "byes") and Tournament.byes(@round) != []}>
    <h2>{gettext("Byes")}</h2>

    <.byes_table slug={@slug} round={@round} players={@players} payload={@payload} />
  </section>

  <.screen_cards payload={@payload} slug={@slug} current={@current} />
<% end %>
