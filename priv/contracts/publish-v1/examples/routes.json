{
  "routes": [
    {
      "method": "GET",
      "path": "/api/server",
      "senders": ["openpairings", "alnasl"],
      "auth": ["none"],
      "request": null,
      "responses": { "200": "server.response.schema.json" }
    },
    {
      "method": "POST",
      "path": "/api/installations",
      "senders": ["openpairings"],
      "auth": ["none"],
      "headers": { "Content-Type": "application/json" },
      "public_publishing_only": true,
      "request": "installation.request.schema.json",
      "responses": { "201": "installation.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "POST",
      "path": "/api/tournaments",
      "senders": ["openpairings"],
      "auth": ["installation"],
      "headers": { "Content-Type": "application/json" },
      "public_publishing_only": true,
      "request": "mint.request.schema.json",
      "responses": { "201": "mint.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "POST",
      "path": "/api/snapshots",
      "senders": ["openpairings"],
      "auth": ["operator", "installation"],
      "headers": {
        "Content-Type": "application/json",
        "X-OpenResults-Key": "the tournament's own key, generated by the publisher; claims an unclaimed slug, required once claimed. Operator only: the ingest token here is break-glass."
      },
      "request": "snapshot.request.schema.json",
      "responses": { "200": "snapshot.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "DELETE",
      "path": "/api/tournaments/:slug",
      "senders": ["openpairings"],
      "auth": ["operator", "installation"],
      "headers": { "X-OpenResults-Key": "the tournament's key (operator: or the ingest token, break-glass)" },
      "request": null,
      "responses": { "200": "takedown.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "GET",
      "path": "/api/tournaments/:slug/claim",
      "senders": ["openpairings"],
      "auth": ["operator"],
      "headers": { "X-OpenResults-Key": "the key to check" },
      "request": null,
      "responses": { "200": "claim.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "GET",
      "path": "/api/tournaments/:slug/history",
      "senders": ["openpairings"],
      "auth": ["operator", "installation"],
      "request": null,
      "responses": {
        "200": "snapshot.request.schema.json (the snapshot current at ?at=<ISO 8601>, without publisher)",
        "4xx/5xx": "error.response.schema.json (OpenPairings' connection test asks about a made-up slug and reads only the status)"
      }
    },
    {
      "method": "GET",
      "path": "/api/tournaments/:slug/registrations",
      "senders": ["openpairings"],
      "auth": ["operator", "installation"],
      "headers": { "X-OpenResults-Key": "the tournament's key, once claimed" },
      "request": null,
      "responses": { "200": "registrations.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "POST",
      "path": "/api/tournaments/:slug/relay-keys",
      "senders": ["openpairings"],
      "auth": ["operator", "installation"],
      "headers": {
        "Content-Type": "application/json",
        "X-OpenResults-Key": "the tournament's key, once claimed (never claims here)"
      },
      "request": "relay-key.request.schema.json",
      "responses": { "201": "relay-key.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "DELETE",
      "path": "/api/tournaments/:slug/relay-keys",
      "senders": [],
      "auth": ["operator", "installation"],
      "headers": { "X-OpenResults-Key": "the tournament's key, once claimed" },
      "request": null,
      "responses": { "200": "relay-key-revoke.response.schema.json", "4xx/5xx": "error.response.schema.json" }
    },
    {
      "method": "POST",
      "path": "/api/tournaments/:slug/live",
      "senders": ["alnasl"],
      "auth": ["relay", "operator", "installation"],
      "headers": {
        "Content-Type": "application/json",
        "X-OpenResults-Key": "the tournament's key once claimed - with the operator token or an installation key only, never with a relay key"
      },
      "request": "live-board.request.schema.json",
      "responses": {
        "200": "live-board.response.schema.json (a body with `boards` is a batch: live-board-batch.request.schema.json -> live-board-batch.response.schema.json)",
        "4xx/5xx": "error.response.schema.json"
      }
    },
    {
      "method": "GET",
      "path": "/api/tournaments/:slug",
      "senders": [],
      "auth": ["none"],
      "request": null,
      "responses": {
        "200": "snapshot.request.schema.json (the current document as stored, without publisher; ?at= is 403 history_requires_auth)",
        "4xx/5xx": "error.response.schema.json"
      }
    }
  ]
}
